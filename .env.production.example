# Copie para .env no servidor e preencha. Nunca envie este arquivo preenchido a ninguém.

# Domínio, sem https://. Exemplo: roleflix.com.br
ROLEFLIX_DOMAIN=
DJANGO_ALLOWED_HOSTS=
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Aparece na política de privacidade e nos termos.
ROLEFLIX_CONTACT_EMAIL=
# Código para criar conta. Deixe vazio só se quiser cadastro aberto a qualquer pessoa.
ROLEFLIX_INVITE_CODE=

# Dados SMTP do serviço de e-mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Rolêflix <nao-responda@SEU-DOMINIO>

# Opcional: entrar com Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
